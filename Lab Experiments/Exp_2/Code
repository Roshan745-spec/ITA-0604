import csv

# Read data from CSV file
with open("trainingdata.csv") as f:
    data = list(csv.reader(f))

# Remove header
data = data[1:]

n = len(data[0]) - 1

# Initialize Specific and General hypotheses
S = ['0'] * n
G = [['?'] * n]

# Candidate Elimination
for row in data:
    x, label = row[:-1], row[-1]

    if label == 'Yes':
        # Generalize S
        for i in range(n):
            if S[i] == '0':
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = '?'

        # Remove inconsistent hypotheses from G
        G = [g for g in G if all(g[i] == '?' or g[i] == x[i] for i in range(n))]

    else:
        # Specialize G
        new_G = []
        for g in G:
            for i in range(n):
                if g[i] == '?':
                    if S[i] != '?' and S[i] != '0' and S[i] != x[i]:
                        new_g = g.copy()
                        new_g[i] = S[i]
                        new_G.append(new_g)
        G = new_G

print("Specific Hypothesis (S):")
print(S)

print("\nGeneral Hypotheses (G):")
for g in G:
    print(g)

